    "note": "tokens live in src/styles/ and src/config/ upstream — read them at analysis time; do not hardcode here"
  },
  "components": {
    "buttons": "src/components/buttons/Button.astro",
    "cards": "src/components/cards/FeatureCard.astro",
    "blog": "BlogPostPreview / BlogPostsList components",
    "pages": "index, 404, blog, company, landing-pages, theme"
  },
  "usability_rules": [ "keep Astro component contracts", "preserve theme config structure (src/config)" ],
  "files": [],
  "conformance_checks": {
    "required_components": [ "src/components/buttons/Button.astro", "src/components/cards/FeatureCard.astro", "src/layouts", "src/pages/index.astro" ],
    "token_keys": [],
    "viewports": [ 375, 768, 1280 ]
  }
}
