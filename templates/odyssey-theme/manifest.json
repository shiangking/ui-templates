  "framework": "astro",
  "import": { "mode": "external-git", "repo": "https://github.com/treefarmstudio/odyssey-theme.git", "sha": "d191e5715a2519e25be4629b933189c421b30a1a", "path": "." },
  "dependencies": [ "astro (see upstream package.json)" ],
  "entry": "src/pages/index.astro",
